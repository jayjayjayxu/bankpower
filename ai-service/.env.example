# Existing BankAI V0.4 source and assets. These remain outside this website
# repository during the V0.1 API-baseline phase.
BANKAI_CORE_DIR=/absolute/path/to/bank-ai

# The legacy core reads this key only from the runtime environment.
DEEPSEEK_API_KEY=replace-with-runtime-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MySQL encrypted login path used by the legacy read-only SQL tool.
BANKAI_SQL_LOGIN_PATH=bank_ai_reader
SPDB_SQL_LOGIN_PATH=bank_ai_local
SPDB_DATABASE=spdb_power_finance
MYSQL_BINARY=/usr/local/mysql/bin/mysql

# API operational settings.
AI_API_AUDIT_DIR=runtime/audit
AI_API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
AI_API_MAX_CONCURRENCY=1
AI_API_DATABASE_HEALTHCHECK=true
AI_API_ENABLE_SQL_DEBUG=false
# When debug is enabled, requests must set X-Admin-Token to this value.
AI_API_SQL_DEBUG_TOKEN=replace-with-a-local-admin-token
